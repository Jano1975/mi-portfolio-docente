---
// src/pages/proyectos/[id].astro
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

// 1. Generamos las rutas estáticas para cada proyecto indexado
export async function getStaticPaths() {
  const proyectos = await getCollection('proyectos');
  return proyectos.map((proyecto) => ({
    params: { id: proyecto.id }, // El parámetro debe coincidir exactamente con el nombre del archivo [id].astro
    props: { proyecto },        // Pasamos el proyecto completo como prop a la página
  }));
}

// 2. Recuperamos el proyecto desde las props de la página
const { proyecto } = Astro.props;

// 3. Renderizamos el componente dinámico <Content /> para el cuerpo del Markdown
const { Content } = await render(proyecto);

// Formateamos la fecha para la cabecera
const fechaFormateada = proyecto.data.pubDate.toLocaleDateString('es-ES', {
  year: 'numeric',
  month: 'long',
});
---

<BaseLayout title={`${proyecto.data.title} | Portfolio Docente`}>
  
  <article class="max-w-3xl w-full mx-auto my-12 px-4">
    
    <!-- Botón de retorno simple -->
    <a href="/mi-portfolio-docente/" class="inline-flex items-center text-sm font-medium text-slate-500 hover:text-indigo-600 mb-8 transition-colors group">
      <svg class="w-4 h-4 mr-2 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
      Volver al inicio
    </a>

    <!-- Cabecera del Artículo -->
    <header class="mb-8 border-b border-slate-100 pb-8">
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <span class="text-xs font-bold tracking-wider text-indigo-600 uppercase bg-indigo-50 px-3 py-1 rounded-full">
          {proyecto.data.nivelEducativo}
        </span>
        <time class="text-sm text-slate-400 font-medium">
          {fechaFormateada}
        </time>
      </div>

      <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl mb-4">
        {proyecto.data.title}
      </h1>

      <p class="text-xl text-slate-600 italic leading-relaxed">
        "{proyecto.data.description}"
      </p>

            <!-- Metodologías utilizadas -->
      <div class="flex flex-wrap items-center justify-between gap-4 mt-6">
        <div class="flex flex-wrap gap-2">
          {proyecto.data.metodologias.map((metodologia) => (
            <span class="text-xs bg-emerald-50 text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-400 px-3 py-1 rounded-md font-medium border border-emerald-100 dark:border-emerald-900/60">
              {metodologia}
            </span>
          ))}
        </div>

        <!-- —— BOTÓN DE DESCARGA DINÁMICO —— -->
        {proyecto.data.downloadUrl && (
          <a
            href={`/mi-portfolio-docente${proyecto.data.downloadUrl}`}
            download
            class="inline-flex items-center gap-2 text-xs font-bold text-white bg-indigo-600 hover:bg-indigo-700 dark:bg-indigo-500 dark:hover:bg-indigo-600 px-4 py-2 rounded-xl shadow-sm transition-colors cursor-pointer"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"></path>
            </svg>
            Descargar Programación (PDF)
          </a>
        )}
      </div>
    </header>

    <!-- Cuerpo del Markdown -->
    <!-- Usamos clases semánticas de espaciado y tipografía nativas -->
    <!-- Cuerpo del Markdown (Contenido Pedagógico) -->
    <div class="prose prose-slate max-w-none 
                prose-headings:font-bold prose-headings:text-slate-900 prose-headings:tracking-tight
                prose-h2:text-2xl prose-h2:border-b prose-h2:border-slate-100 prose-h2:pb-2 prose-h2:mt-8
                prose-h3:text-xl prose-h3:mt-6
                prose-p:text-slate-700 prose-p:leading-relaxed prose-p:text-base
                prose-ul:list-disc prose-ul:pl-6 prose-ul:space-y-2 prose-li:text-slate-700">
      <Content />
    </div>


  </article>

</BaseLayout>
