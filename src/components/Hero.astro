---
// src/components/Hero.astro
---

<section id="sobre-mi" class="max-w-5xl w-full mx-auto pt-16 pb-12 px-4 border-b border-slate-100">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
    
    <!-- Bloque de Texto Principal (8 columnas de 12) -->
    <div class="lg:col-span-8 space-y-6">
      <div class="inline-flex items-center gap-2 bg-indigo-50 border border-indigo-100 rounded-full px-3 py-1 text-xs font-semibold text-indigo-700">
        <span class="flex h-2 w-2 relative">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-indigo-500"></span>
        </span>
        En formación: Habilitación Docente 2026
      </div>

      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-none">
        Hola, soy un perfil <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-emerald-600">Full-Stack</span> apasionado por la enseñanza.
      </h1>

      <p class="text-lg text-slate-600 leading-relaxed max-w-2xl">
        Combino mi experiencia técnica en el desarrollo de software con metodologías didácticas activas. Mi objetivo es formar a las próximas generaciones de profesionales técnicos, haciendo que el código sea accesible, estructurado y aplicable al mundo real.
      </p>

      <!-- Botones de Acción Rápida -->
      <div class="flex flex-wrap gap-3 pt-2">
        <a href="#proyectos" class="inline-flex items-center justify-center text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 px-5 py-2.5 rounded-xl shadow-sm shadow-indigo-100 transition-all">
          Ver proyectos de aula
        </a>
        <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center text-sm font-semibold text-slate-700 bg-white dark:bg-slate-900 border border-slate-200 hover:bg-slate-50 px-5 py-2.5 rounded-xl transition-all">
          Conectar en LinkedIn
        </a>
      </div>
    </div>

    <!-- Bloque de Stack / Perfil Visual (4 columnas de 12) -->
    <div class="lg:col-span-4 bg-white dark:bg-slate-900 border border-slate-100 p-6 rounded-2xl shadow-sm space-y-4">
      <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase tracking-wider">Mi Perfil Híbrido</h3>
      
      <div class="space-y-3">
        <!-- Tarjeta interna: Desarrollo -->
        <div class="p-3 bg-slate-50 rounded-xl flex items-start gap-3">
          <span class="text-xl">💻</span>
          <div>
            <h4 class="text-sm font-semibold text-slate-900 dark:text-white">Dev Core</h4>
            <p class="text-xs text-slate-500">JavaScript, TypeScript, Astro, Node.js</p>
          </div>
        </div>

        <!-- Tarjeta interna: Pedagogía -->
        <div class="p-3 bg-slate-50 rounded-xl flex items-start gap-3">
          <span class="text-xl">📚</span>
          <div>
            <h4 class="text-sm font-semibold text-slate-900 dark:text-white">Enfoque Pedagógico</h4>
            <p class="text-xs text-slate-500">ABP (Proyectos), Gamificación, FP</p>
          </div>
        </div>
      </div>

      <div class="pt-2">
        <span class="text-[11px] text-slate-400 block font-mono">Arteixo, Galicia • Remoto / Presencial</span>
      </div>
    </div>

  </div>
</section>
